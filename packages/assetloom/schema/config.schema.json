{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapkalabs.dev/assetloom/config.schema.json",
  "title": "Assetloom configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "targets",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "android": {
          "$ref": "#/$defs/androidTarget"
        },
        "ios": {
          "$ref": "#/$defs/iosTarget"
        }
      }
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/appIcon"
          },
          {
            "$ref": "#/$defs/notificationIcon"
          },
          {
            "$ref": "#/$defs/splashScreen"
          }
        ]
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\u0000"
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "androidTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "resourceDirectory",
        "manifestPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resourceDirectory": {
          "$ref": "#/$defs/path"
        },
        "manifestPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "iosTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "projectDirectory",
        "projectFile",
        "assetCatalogDirectory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "projectDirectory": {
          "$ref": "#/$defs/path"
        },
        "projectFile": {
          "$ref": "#/$defs/path"
        },
        "assetCatalogDirectory": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "androidAppIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legacy": {
          "$ref": "#/$defs/sourceReference"
        },
        "round": {
          "$ref": "#/$defs/sourceReference"
        },
        "adaptive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foreground",
            "background"
          ],
          "properties": {
            "foreground": {
              "$ref": "#/$defs/sourceReference"
            },
            "background": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color"
                  ],
                  "properties": {
                    "color": {
                      "$ref": "#/$defs/color"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "$ref": "#/$defs/path"
                    }
                  }
                }
              ]
            },
            "monochrome": {
              "$ref": "#/$defs/sourceReference"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "legacy"
          ]
        },
        {
          "required": [
            "adaptive"
          ]
        }
      ]
    },
    "iosAppIcon": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "light"
          ],
          "properties": {
            "mode": {
              "const": "variants"
            },
            "light": {
              "$ref": "#/$defs/sourceReference"
            },
            "dark": {
              "$ref": "#/$defs/sourceReference"
            },
            "tinted": {
              "$ref": "#/$defs/sourceReference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "source"
          ],
          "properties": {
            "mode": {
              "const": "icon-composer"
            },
            "source": {
              "$ref": "#/$defs/path"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          }
        }
      ]
    },
    "appIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "app-icon"
        },
        "android": {
          "$ref": "#/$defs/androidAppIcon"
        },
        "ios": {
          "$ref": "#/$defs/iosAppIcon"
        }
      },
      "anyOf": [
        {
          "required": [
            "android"
          ]
        },
        {
          "required": [
            "ios"
          ]
        }
      ]
    },
    "notificationIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "android"
      ],
      "properties": {
        "type": {
          "const": "notification-icon"
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/path"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "splashAppearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "backgroundColor",
        "imageWidth"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/path"
        },
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "imageWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024
        }
      }
    },
    "splashScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "light"
      ],
      "properties": {
        "type": {
          "const": "splash-screen"
        },
        "light": {
          "$ref": "#/$defs/splashAppearance"
        },
        "dark": {
          "$ref": "#/$defs/splashAppearance"
        }
      }
    }
  }
}
